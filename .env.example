# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# Get these values from Firebase Console → Project Settings → Your apps
#
# ВАЖНО: Vite подставляет VITE_*-переменные НА ЭТАПЕ СБОРКИ. Поэтому их нужно
# задать в окружении сборки на Cloudflare, а не только локально — иначе бандл
# уедет в прод с firebaseConfig: undefined.
#
# Эти значения не секрет: web-конфиг Firebase публичен по дизайну, доступ
# ограничивают firestore.rules. Но ключ стоит ограничить по HTTP-referrer
# в Google Cloud Console → Credentials.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
